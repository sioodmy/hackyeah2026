# ---------------------------------------------------------------------------
# Safe Call - local development environment
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Postgres (docker compose) ------------------------------------------------
POSTGRES_USER=safecall
POSTGRES_PASSWORD=safecall
POSTGRES_DB=safecall
POSTGRES_PORT=5432
# Used by the server when DATABASE_URL is not set explicitly
DATABASE_URL=postgres://safecall:safecall@localhost:5432/safecall

# --- Server -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# --- Clerk --------------------------------------------------------------------
# https://dashboard.clerk.com -> API Keys
# Publishable key is used by the mobile app (EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Set to 1 to bypass Clerk verification and use the X-Dev-User header instead.
DEV_AUTH=0

# --- Push notifications (Expo) -----------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Mobile app ---------------------------------------------------------------
# Use 'localhost' for the iOS simulator, '10.0.2.2' for the Android emulator.
# A physical device needs your machine's LAN IP, e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_HOST=10.0.2.2
EXPO_PUBLIC_API_PORT=4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:4000/ws

# ---------------------------------------------------------------------------
# OSM raster tile template. Must contain {z}, {x}, {y}.
# `light_all` is a muted, minimal, OSM-derived basemap that reads as an ordinary
# map from a distance. Swap for the plain OSM tiles if you prefer:
#   https://tile.openstreetmap.org/{z}/{x}/{y}.png
# ---------------------------------------------------------------------------
EXPO_PUBLIC_TILE_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}@2x.png
EXPO_PUBLIC_TILE_MAX_ZOOM=20

# Seconds of silence before level 1 auto-starts the fake incoming call.
EXPO_PUBLIC_FAKE_CALL_DELAY_MS=10000

# How long the thumb has to rest in the middle of the rail to stand an alert
# down. Long enough that it cannot happen by accident.
EXPO_PUBLIC_HOLD_TO_STAND_DOWN_MS=2200