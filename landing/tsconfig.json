{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["../app/src/*"],
      "@demo": ["../web/src/DemoPhone.tsx"]
    }
  },
  // Tylko to, co sekcja demo realnie konsumuje. Świadomie **nie** ciągniemy
  // całego `app/src`: `theme/mapStyle.ts` czyta `process.env` z Expa, co nie
  // istnieje w zwykłym projekcie webowym, a demo i tak go nie importuje.
  // Gdyby kiedyś przestało być prawdą, build to zgłosi.
  "include": [
    "src",
    "../web/src/**/*",
    "../app/src/theme/tokens.ts",
    "../app/src/theme/levels.ts",
    "../app/src/lib/avatar.ts"
  ]
}
