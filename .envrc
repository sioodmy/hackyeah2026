if ! has nix_direnv_version || ! has use_flake; then
  echo "direnv: nix_direnv is not available; skipping .envrc" >&2
  return 0
fi

use flake

# Keep uv from downloading its own interpreter: the devShell already provides
# Python, and NixOS cannot exec uv's standalone build.
export UV_PYTHON_DOWNLOADS=never

watch_file flake.nix
watch_file app/.env
watch_file backend/.env

if [ -d app/node_modules ]; then
  export PATH="$PWD/app/node_modules/.bin:$PATH"
fi