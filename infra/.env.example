# Backend configuration. Copy to `backend/.env` and fill in.
#
# The backend fails closed: with no Clerk key configured, every authenticated
# route returns 401 rather than trusting an unverified token.

# --- database ---------------------------------------------------------------
# Default matches scripts/db.sh's nix-postgres fallback (port 5433).
# With docker compose it is `postgresql+psycopg://panicmap:panicmap@127.0.0.1:5432/panicmap`.
DATABASE_URL=postgresql+psycopg://panicmap@127.0.0.1:5433/panicmap

# --- clerk ------------------------------------------------------------------
# Dashboard → API Keys. Prefer CLERK_JWT_KEY: verification is then a local
# RS256 signature check with no network round-trip to Clerk.
#
# CLERK_JWT_KEY is the PEM block with real newlines replaced by \n.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Comma-separated origins allowed to request tokens from this API.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:8081","panicmap://"]

# --- signed QR invites ------------------------------------------------------
# Change this outside development: it is the HMAC key that stops someone
# crafting a QR code for an arbitrary user id.
INVITE_SIGNING_KEY=dev-invite-key-change-me

# --- expo push --------------------------------------------------------------
# Without this, pushes still work for development builds but not reliably for
# production builds.
EXPO_ACCESS_TOKEN=

# --- evidence ---------------------------------------------------------------
EVIDENCE_DIR=./var/evidence
EVIDENCE_MAX_CHUNK_BYTES=33554432

# --- realtime ---------------------------------------------------------------
WS_HEARTBEAT_SECONDS=15
WS_REPLAY_LIMIT=20

# --- misc -------------------------------------------------------------------
LOG_LEVEL=INFO
DISPATCH_ARTIFICIAL_DELAY_SECONDS=0.4
CORS_ORIGINS=["*"]
# Set only when the schema is provisioned elsewhere (the test suite does it).
# HY_SKIP_CREATE_ALL=1
