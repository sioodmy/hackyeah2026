{
  "name": "safe-call",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @safecall/server dev",
    "dev:mobile": "pnpm --filter @safecall/mobile start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @safecall/server db:migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --no-bail lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
