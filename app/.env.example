# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle.
# Never put a secret key here.
# ---------------------------------------------------------------------------

# Clerk — Dashboard → API Keys → Publishable key (starts with pk_test_ / pk_live_)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend address. Leave unset in development and it is derived from the Metro
# host, which is what you want on a physical phone on the same wifi.
#   Android emulator: http://10.0.2.2:8000
#   Physical device:  http://<your-lan-ip>:8000
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# EAS project id — needed to mint an Expo push token on a physical device.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: point at your own tile server. Defaults to OpenStreetMap's public
# tiles, which their usage policy asks you not to rely on at volume.
# EXPO_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
