{
  "expo": {
    "name": "Mokosh",
    "slug": "mokosh",
    "scheme": "mokosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14161A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "pl.hackyeah.mokosh",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Twoja lokalizacja jest udostępniana znajomym tylko wtedy, gdy zaznaczysz poziom zagrożenia.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Twoja lokalizacja jest udostępniana znajomym tylko wtedy, gdy zaznaczysz poziom zagrożenia.",
        "NSMicrophoneUsageDescription": "Nagrywanie dźwięku aktywuje się wyłącznie przy najwyższym poziomie zagrożenia.",
        "UIBackgroundModes": ["audio", "location", "remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "pl.hackyeah.mokosh",
      "versionCode": 10000,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "mokosh"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-camera",
        {
          "cameraPermission": "Skanujemy kod QR znajomej, żeby połączyć konta."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Twoja lokalizacja jest udostępniana znajomym tylko przy aktywnym zagrożeniu."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nagrywanie dźwięku aktywuje się wyłącznie przy najwyższym poziomie zagrożenia."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D62828",
          "defaultChannel": "default"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "caf73a06-6577-43bc-926e-155f0de3fc04"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "grajpap"
  }
}
