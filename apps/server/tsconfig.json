{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
