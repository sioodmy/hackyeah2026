# Copy to `backend/.env` and fill in. See infra/.env.example for the full list.
DATABASE_URL=postgresql+psycopg://panicmap@127.0.0.1:5433/panicmap
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:8081"]
INVITE_SIGNING_KEY=dev-invite-key-change-me
EXPO_ACCESS_TOKEN=
EVIDENCE_DIR=./var/evidence
LOG_LEVEL=INFO
# Fills the incident table with INVENTED demo reports so the heatmap is not empty.
# Leave at 0 for anything real. See infra/.env.example for the full explanation.
HY_SEED_DEMO_INCIDENTS=0
