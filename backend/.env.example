# App
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
API_PREFIX=/api/v1

# Postgres
# Left blank on purpose: the app connects over the local Unix socket as your own
# macOS role, which is how Homebrew Postgres is set up. Uncomment only if yours
# needs a password or a different host.
# DATABASE_URL=postgresql://user:password@localhost:5432/safety

# Clerk - the only value you must fill in before the API will boot.
# Dashboard -> API Keys -> JWKS URL
CLERK_JWKS_URL=
CLERK_ISSUER=

# Android push (FCM HTTP v1)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# iOS push (APNs .p8 key, newlines escaped as \n)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.safety
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true

# Email - danger alerts (levels 3 and 4) go out by email as well as push,
# because a phone with no push connection still receives mail. Leave SMTP_HOST
# blank to disable; alerts are still recorded either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Safety Alert <alerts@safetyapp.example>

# Invite links - the public origin used in QR codes and share links, and the
# scheme the mobile app registers for deep links.
PUBLIC_BASE_URL=
APP_LINK_SCHEME=safetyapp

# Alert escalation
ESCALATE_UNSAFE_AFTER_MINUTES=15
ESCALATE_DANGER_AFTER_MINUTES=5
CANCEL_WINDOW_SECONDS=30

# Optional: called on every omega alert
EMERGENCY_WEBHOOK_URL=
EMERGENCY_WEBHOOK_SECRET=